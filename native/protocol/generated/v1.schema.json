{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sse.exed/protocol/v1.schema.json",
  "title": "SSE ExEd Studio Control Protocol v1",
  "type": "object",
  "properties": {
    "version": {
      "const": "2"
    },
    "transport": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "jsonl-over-stdin-stdout"
        },
        "requestKind": {
          "const": "request"
        },
        "responseKind": {
          "const": "response"
        },
        "eventKind": {
          "const": "event"
        }
      },
      "required": ["mode", "requestKind", "responseKind", "eventKind"],
      "additionalProperties": false
    },
    "startupLifecycleStates": {
      "type": "array",
      "items": {
        "enum": [
          "idle",
          "launching-process",
          "waiting-for-ready-event",
          "waiting-for-health-snapshot",
          "waiting-for-app-snapshot",
          "ready",
          "failed"
        ]
      }
    },
    "snapshotShapes": {
      "const": {
        "lightingFixtureVisual": {
          "additiveFields": ["symbolKind", "symbolVariant", "emitterLayout", "output", "visualConfidence"],
          "symbolKind": ["panel", "soft-mat", "linear-bar", "fresnel", "control-node"],
          "beamType": ["wash", "spot", "fresnel", "rectangle", "glow", "none"],
          "visualConfidence": ["verified", "catalogue-derived", "fallback"]
        }
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "enum": [
          "app.snapshot",
          "audio.channel.update",
          "audio.channel.dynamics.update",
          "audio.channel.eq.update",
          "audio.clip.clear",
          "audio.mixTarget.update",
          "audio.settings.update",
          "audio.solo.clearAll",
          "audio.snapshot",
          "audio.snapshot.load",
          "audio.sync",
          "commissioning.check.run",
          "commissioning.snapshot",
          "commissioning.update",
          "controlSurface.snapshot",
          "engine.ping",
          "exports.companion.export",
          "health.snapshot",
          "lighting.dmxMonitor.snapshot",
          "lighting.fixtureCatalog.snapshot",
          "lighting.editor.previewDiscard",
          "lighting.editor.previewMode",
          "lighting.fixture.create",
          "lighting.fixture.delete",
          "lighting.fixture.highlight",
          "lighting.fixture.identify",
          "lighting.fixture.identify.clearAll",
          "lighting.fixture.identifySequence",
          "lighting.fixture.update",
          "lighting.group.create",
          "lighting.group.delete",
          "lighting.group.power",
          "lighting.group.reorder",
          "lighting.group.update",
          "lighting.output.setArmed",
          "lighting.palette.apply",
          "lighting.palette.create",
          "lighting.palette.delete",
          "lighting.palette.list",
          "lighting.palette.update",
          "lighting.power.all",
          "lighting.scene.create",
          "lighting.scene.delete",
          "lighting.scene.pin",
          "lighting.scene.recall",
          "lighting.scene.reorder",
          "lighting.scene.update",
          "lighting.settings.update",
          "lighting.snapshot",
          "prompter.clear",
          "prompter.glass.snapshot",
          "prompter.jump",
          "prompter.layout.report",
          "prompter.look.update",
          "prompter.paste.convert",
          "prompter.pause",
          "prompter.play",
          "prompter.putOn",
          "prompter.screen.report",
          "prompter.script.create",
          "prompter.script.delete",
          "prompter.script.edit",
          "prompter.script.import",
          "prompter.script.paste",
          "prompter.script.remove",
          "prompter.script.rename",
          "prompter.script.restore",
          "prompter.script.snapshot",
          "prompter.script.version.bringBack",
          "prompter.snapshot",
          "prompter.speed",
          "prompter.textSize",
          "prompter.update",
          "settings.get",
          "settings.update",
          "support.backup.export",
          "support.backup.restore",
          "support.backup.verify",
          "support.snapshot",
          "cameras.snapshot",
          "cameras.select",
          "cameras.bank.set",
          "cameras.set",
          "cameras.step",
          "cameras.auto",
          "cameras.format.set",
          "cameras.look.set",
          "cameras.record.start",
          "cameras.record.stop",
          "cameras.release",
          "cameras.connect",
          "cameras.setup.update",
          "cameras.setup.pair",
          "cameras.setup.forget",
          "cameras.pictures.showing"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "enum": [
          "app.changed",
          "audio.changed",
          "audio.meters",
          "cameras.changed",
          "commissioning.changed",
          "engine.exited",
          "engine.ready",
          "engine.startupFailed",
          "lighting.changed",
          "prompter.changed",
          "settings.changed",
          "support.changed"
        ]
      }
    }
  },
  "required": ["version", "transport", "startupLifecycleStates", "snapshotShapes", "methods", "events"],
  "additionalProperties": false
}
