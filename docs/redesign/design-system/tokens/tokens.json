  "elevation": {
    "well": "inset 2px 2px 4px shade, inset -1px -1px 1px sheen",
    "panel": "inset 1px 1px 0 sheen, 0 0 0 1px shade-edge, 2px 2px 6px shade",
    "key": "inset 1px 1px 0 sheen, inset -1px -1px 0 shade-edge, 1px 1px 3px shade",
    "keyDown": "inset 2px 2px 4px shade, inset -1px -1px 1px sheen + translateY(1px)",
    "float": "0 12px 32px shade-deep, 0 0 0 1px shade-edge, inset 1px 1px 0 sheen",
    "edgeMachined": "0 1px 0 shade-edge, 0 2px 0 sheen"
  }
}
