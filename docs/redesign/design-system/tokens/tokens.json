{
  "$schema": "brief v1.1 \u00a74\u2013\u00a79",
  "font": {
    "family": {
      "ui": "Inter",
      "mono": "JetBrains Mono",
      "display": "Fraunces"
    },
    "scale": {
      "tick": {
        "size": 10,
        "lineHeight": 12,
        "weight": "500",
        "role": "Axis ticks, meter scales, legends. Mono. Never on a control."
      },
      "caption": {
        "size": 11,
        "lineHeight": 14,
        "weight": "500 / 600",
        "role": "Secondary labels, kbd hints, chip text, badge words, key caps (600, uppercase, +0.06em)."
      },
      "dense": {
        "size": 12,
        "lineHeight": 16,
        "weight": "400 / 500",
        "role": "Table and list rows, strip names, tile meta."
      },
      "body": {
        "size": 13,
        "lineHeight": 18,
        "weight": "400 / 500",
        "role": "Default: control labels, inspector rows, dialog body, toasts."
      },
      "emphasis": {
        "size": 14,
        "lineHeight": 18,
        "weight": "500 / 600",
        "role": "Inspector values, rows the operator scans first."
      },
      "title": {
        "size": 16,
        "lineHeight": 20,
        "weight": "600",
        "role": "Section titles, nav labels, inspector heading."
      },
      "display": {
        "size": 20,
        "lineHeight": 24,
        "weight": "500",
        "role": "Workspace title, dialog title (Fraunces)."
      },
      "hero": {
        "size": 28,
        "lineHeight": 30,
        "weight": "500",
        "role": "Master level, the clock, the arm countdown numeral (mono)."
      }
    },
    "trackingStamped": "0.06em"
  },
  "radius": {
    "ctl": 4,
    "card": 8,
    "float": 12,
    "pill": 999
  },
  "motion": {
    "lamp": {
      "ms": 60,
      "easing": "none \u2014 a light does not ramp"
    },
    "key": {
      "ms": 100,
      "easing": "mechanical cubic-bezier(0.2, 0.8, 0.2, 1)"
    },
    "state": {
      "ms": 160,
      "easing": "out"
    },
    "enter": {
      "ms": 200,
      "easing": "out, 8 px rise + fade"
    },
    "exit": {
      "ms": 120,
      "easing": "in, fade only"
    },
    "move": {
      "ms": 160,
      "easing": "in-out"
    }
  },
  "themes": {
    "studio": {
      "chassis": "#0D0F0D",
      "panel": "#151815",
      "well": "#090B09",
      "float": "#1B1F1B",
